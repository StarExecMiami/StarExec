<Context>
  <!-- Disable persistent sessions -->
  <Manager className="org.apache.catalina.session.StandardManager" pathname=""/>

  <!-- JNDI DataSource used by DataSourceRealm -->
  <Resource name="jdbc/StarExecDB"
            auth="Container"
            type="javax.sql.DataSource"
            factory="org.apache.tomcat.jdbc.pool.DataSourceFactory"
            driverClassName="org.postgresql.Driver"
            url="jdbc:postgresql://${STAREXEC_DB_HOST}:${STAREXEC_DB_PORT}/${STAREXEC_DB_NAME}?ssl=false&amp;currentSchema=starexec"
            username="${STAREXEC_DB_USER}"
            password="${STAREXEC_DB_PASSWORD}"
            maxActive="20"
            maxIdle="10"
            maxWait="10000"
            validationQuery="SELECT 1"
            testOnBorrow="true"/>

  <!-- Use PostgreSQL users/roles for container-managed auth (FORM j_security_check) -->
  <Realm className="org.apache.catalina.realm.LockOutRealm">
    <Realm className="org.apache.catalina.realm.DataSourceRealm"
            dataSourceName="jdbc/StarExecDB"
            localDataSource="true"
            userTable="users"
            userNameCol="email"
            userCredCol="password"
            userRoleTable="user_roles"
            roleNameCol="role">
            <!-- BCrypt credential handler for secure password authentication -->
            <CredentialHandler className="org.starexec.tomcat.BCryptCredentialHandler"/>
    </Realm>
  </Realm>

  <!-- Legacy cookie processor to match app expectations.
       Note: sameSiteCookies attribute intentionally omitted (defaults to unset/none).
       Reason: Cross-origin authentication flows (e.g., StarExecCommand, Python API)
       require cookies to be sent on cross-site requests. CSRF protection is handled
       at the application level via session tokens and origin validation in SessionFilter.
       If only browser-based access is needed, consider adding sameSiteCookies="lax". -->
  <CookieProcessor className="org.apache.tomcat.util.http.Rfc6265CookieProcessor" />

  <!-- Fix 408 login timeout - Tomcat 9.0.74+ defaults authenticationSessionTimeout to 120 seconds.
       Set to 3600 (1 hour) to match web.xml session-timeout and prevent timeout during login. -->
  <Valve className="org.apache.catalina.authenticator.FormAuthenticator"
         authenticationSessionTimeout="3600"
         landingPage="/" />
</Context>
