{
  "name": "starexec",
  "private": true,
  "version": "1.0.0",
  "description": "Build tooling for StarExec web assets",
  "scripts": {
    "sass-build": "sass --style=compressed --load-path=src/main/webapp/css src/main/webapp/css:src/main/webapp/css",
    "lint:css": "stylelint 'src/main/webapp/css/**/*.scss'",
    "lint:css:fix": "stylelint 'src/main/webapp/css/**/*.scss' --fix"
  },
  "devDependencies": {
    "jquery": "3.7.1",
    "jquery-migrate": "3.5.2",
    "jquery-ui-dist": "1.13.3",
    "jquery-validation": "1.21.0",
    "sass": "1.69.5",
    "stylelint": "^16.11.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.8.1"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "flatted": "3.4.2",
    "immutable": "4.3.9",
    "picomatch": "2.3.2"
  }
}
