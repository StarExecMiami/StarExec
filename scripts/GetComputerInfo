#!/bin/bash
#==============================================================================
# GetComputerInfo - Shell Version
#
# Lightweight replacement for the Perl GetComputerInfo script.
# Designed for containerized environments where we need minimal footprint.
#
# This script outputs system information in a format compatible with
# theorem provers and other solvers that expect StarExec system headers.
#
# Usage: GetComputerInfo [-s] [-p]
#   -s  Silent mode (suppress DNS lookup errors)
#   -p  Pretty print mode (no-op, for backward compatibility)
#
# Output format:
#   % Computer   : hostname
#   % Model      : CPU model
#   % CPU        : speed
#   % Memory     : total RAM
#   % OS         : operating system info
#==============================================================================

# Safety mode: exit on error, undefined variables, and pipe failures
set -euo pipefail
#   % CPULimit   : (if STAREXEC_CPU_LIMIT set)
#   % WCLimit    : (if STAREXEC_WALLCLOCK_LIMIT set)
#   % MemLimit   : (if STAREXEC_MEM_LIMIT set)
#
#==============================================================================

# Parse arguments
SILENT=0
PRETTY=0
while getopts "sp" opt; do
    case $opt in
        s) SILENT=1 ;;
        p) PRETTY=1 ;;
        *) ;;
    esac
done

# Detect container environment
in_container() {
    [ -f /.dockerenv ] || [ -f /run/.containerenv ] || [ -n "${container:-}" ]
}

# Get hostname (try FQDN first)
get_hostname() {
    local host=""

    # Try hostname -f first
    host=$(hostname -f 2>/dev/null) || host=$(hostname 2>/dev/null) || host="unknown"

    # If in container and got a short hash, try to get more info
    if in_container && [ ${#host} -le 12 ]; then
        # Container ID as hostname is fine
        echo "$host (container)"
    else
        echo "$host"
    fi
}

# Get CPU model
get_cpu_model() {
    if [ -f /proc/cpuinfo ]; then
        grep -m1 "model name" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^ *//' || echo "Unknown"
    else
        echo "Unknown"
    fi
}

# Get CPU count
get_cpu_count() {
    if [ -f /proc/cpuinfo ]; then
        grep -c "^processor" /proc/cpuinfo 2>/dev/null || echo "1"
    else
        echo "1"
    fi
}

# Get CPU frequency
get_cpu_freq() {
    if [ -f /proc/cpuinfo ]; then
        local mhz=$(grep -m1 "cpu MHz" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^ *//')
        if [ -n "$mhz" ]; then
            # Convert to GHz with 2 decimal places
            echo "$mhz" | awk '{printf "%.2f GHz", $1/1000}'
        else
            echo "Unknown"
        fi
    else
        echo "Unknown"
    fi
}

# Get total memory
get_memory() {
    if [ -f /proc/meminfo ]; then
        local kb=$(grep "MemTotal" /proc/meminfo 2>/dev/null | awk '{print $2}')
        if [ -n "$kb" ]; then
            # Convert to MB
            echo "$((kb / 1024)) MB"
        else
            echo "Unknown"
        fi
    else
        echo "Unknown"
    fi
}

# Get OS info
get_os() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release 2>/dev/null
        echo "${PRETTY_NAME:-Linux}"
    elif [ -f /etc/alpine-release ]; then
        echo "Alpine Linux $(cat /etc/alpine-release)"
    else
        uname -sr 2>/dev/null || echo "Linux"
    fi
}

# Get kernel version
get_kernel() {
    uname -r 2>/dev/null || echo "Unknown"
}

# Output system information
output_info() {
    local hostname=$(get_hostname)
    local cpu_model=$(get_cpu_model)
    local cpu_count=$(get_cpu_count)
    local cpu_freq=$(get_cpu_freq)
    local memory=$(get_memory)
    local os=$(get_os)
    local kernel=$(get_kernel)

    echo "% Computer   : $hostname"
    echo "% Model      : $cpu_model"
    echo "% CPU        : ${cpu_count}x @ ${cpu_freq}"
    echo "% Memory     : $memory"
    echo "% OS         : $os"
    echo "% Kernel     : $kernel"

    # Include StarExec limits if set
    if [ -n "${STAREXEC_CPU_LIMIT:-}" ]; then
        echo "% CPULimit   : ${STAREXEC_CPU_LIMIT}"
    fi
    if [ -n "${STAREXEC_WALLCLOCK_LIMIT:-}" ]; then
        echo "% WCLimit    : ${STAREXEC_WALLCLOCK_LIMIT}"
    fi
    if [ -n "${STAREXEC_MEM_LIMIT:-}" ]; then
        echo "% MemLimit   : ${STAREXEC_MEM_LIMIT}MB"
    fi

    # Mark container environment
    if in_container; then
        echo "% Container  : yes"
    fi
}

# Main
output_info
