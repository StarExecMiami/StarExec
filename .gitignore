# StarExec - Git ignore file

####################################
# Project build artifacts
####################################
**/target/
**/build/
**/bin/
**/dist/
**/junittestoutput/
**/data_dir/
**/deployed-upload-test/
**/*.war
**/*.ear
**/*.jar
**/*.class

####################################
# Node / front-end
####################################
**/node/
**/node_modules/
**/npm-debug.log
**/yarn-debug.log
**/yarn-error.log

####################################
# Logs & temporary files
####################################
**/*.log
**/*.tmp
**/output.log
**/logs/
**/*.swp
**/*.swo
**/*~
**/.tmp
**/.cache

####################################
# OS & Editor junk
####################################
**/.DS_Store
**/Thumbs.db

####################################
# IDE & Project files
####################################
**/.classpath
**/.project
**/.settings/
**/.idea/
**/*.iml
**/.vscode/
**/.history/
**/.factorypath

####################################
# Sass
####################################
**/.sass-cache/
**/*.css.map
**/*.scss.map

# Generated CSS from SCSS (keep only SCSS sources)
# Vendor CSS files are explicitly tracked via git add -f
**/css/**/*.css
!**/css/datatables/*.css
!**/css/jqueryui/*.css
!**/css/jstree/**/*.css
!**/css/explore/jquery.qtip.css

####################################
# Legacy/Ant / Maven wrapper
####################################
**/.mvn/

####################################
# Maven build artifacts
####################################
**/dependency-reduced-pom.xml

####################################
# Python / test caches
####################################
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/pip-wheel-metadata/

####################################
# Archives, backups & DB dumps
####################################
**/*.zip
**/backups/
**/*.tar.gz
**/*.sql
**/*.sql.gz
**/*.backup

# But allow tracked migration scripts
!**/db/migration/*.sql
!**/sql/**/*.sql
!**/config/pagination/*.sql

####################################
# Docker / Podman / Container
####################################
**/.buildah/
**/.podman/
**/docker-compose.override.yml
**/.docker/
# Track .dockerignore — it is a committed project file, not a local override
!.dockerignore
**/.env
**/.env.*
**/pvc-render.yaml

####################################
# Render / deployment configs (ignore local secrets/overrides)
####################################
/render.yaml
**/secret-render.yaml
**/secret-*.yaml
**/values-podman.yaml
**/values-local.yaml
/**/*-local.yaml

####################################
# Keys, credentials, sensitive files
####################################
**/*.jks
**/*.keystore
**/*.pem
**/*.key
**/*.crt
**/secrets/
**/credentials/

####################################
# Misc
####################################
**/output/
**/coverage/
**/coverage-report/
**/reports/
**/*-report.json
**/*-analysis.json
**/test-*.html
