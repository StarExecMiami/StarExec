# StarExec - Git ignore file

####################################
# Project build artifacts
####################################
/target/
build/
bin/
dist/
junittestoutput/
data_dir/
deployed-upload-test/
WEB-INF/classes/
WEB-INF/lib/
META-INF/maven/
*.war
*.ear
*.jar
*.class

####################################
# Node / front-end
####################################
node/
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

####################################
# Logs & temporary files
####################################
*.log
*.tmp
output.log
logs/
*.swp
*.swo
*~
.tmp
.cache

####################################
# OS & Editor junk
####################################
.DS_Store
Thumbs.db

####################################
# IDE & Project files
####################################
.classpath
.project
.settings/
.idea/
*.iml
.vscode/
.vscode/*
/.history/

####################################
# Sass
####################################
.sass-cache/
**/*.css.map
**/*.scss.map

# Generated CSS from SCSS (keep only SCSS sources)
# Vendor CSS files are explicitly tracked via git add -f
src/main/webapp/css/**/*.css
!src/main/webapp/css/datatables/*.css
!src/main/webapp/css/jqueryui/*.css
!src/main/webapp/css/jstree/**/*.css
!src/main/webapp/css/explore/jquery.qtip.css

####################################
# Legacy/Ant / Maven wrapper
####################################
.mvn/
.mvn/wrapper/
.mvn/wrapper/maven-wrapper.jar

####################################
# Python / test caches
####################################
__pycache__/
*.pyc
.pytest_cache/
pip-wheel-metadata/

####################################
# Archives, backups & DB dumps
####################################
distribution/*.zip
backups/
*.tar.gz
*.zip
*.sql
*.sql.gz

# But allow tracked migration scripts
!src/main/resources/db/migration/*.sql
!src/main/resources/sql/**/*.sql

####################################
# Docker / Podman / Container
####################################
.buildah/
.podman/
docker-compose.override.yml
.docker/
.dockerignore
.env
.env.*
pvc-render.yaml

####################################
# Render / deployment configs (ignore local secrets/overrides)
####################################
render.yaml
secret-render.yaml
secret-*.yaml
backups/
values-podman.yaml
values-local.yaml
*-local.yaml

####################################
# Keys, credentials, sensitive files
####################################
*.jks
*.keystore
*.pem
*.key
*.crt
secrets/
credentials/
*.env

####################################
# Misc
####################################
output/
coverage/
coverage-report/
reports/
