# Podman environment values — EXAMPLE / TEMPLATE
#
# Copy this file to values-podman.yaml and fill in the placeholders:
#
#   cp charts/starexec/values-podman.yaml.example charts/starexec/values-podman.yaml
#
# For production, copy it to values-podman-prod.yaml instead and deploy with
#   make deploy-podman ENV=prod VALS=charts/starexec/values-podman-prod.yaml
# (docs/DEPLOYMENT.md, Method 2).
#
# Both copies are gitignored because they may contain real credentials.
# Never commit them; commit changes here instead.
#
# Usage: make deploy-podman ENV=podman

image:
  repository: localhost/starexec
  tag: latest
  pullPolicy: Never

replicaCount: 1
volumePrefix: starexec

kubernetes:
  enabled: false

persistence:
  enabled: true
  storageClass: ""
  useHostPathForPodman: false
  usePodmanVolumes: true

postgres:
  image:
    repository: docker.io/library/postgres
    pullPolicy: IfNotPresent
    tag: "15"

  host: localhost
  port: 5432
  user: starexec
  allowInsecureDevCredentials: true
  # Replace with a strong random password. For local dev the default seeded
  # credentials (admin:admin, public:public) are already baked into the
  # migrations, so any value you choose here only protects the DB socket.
  # A deployment rendered with Helm uses this value as the database password;
  # `make deploy-podman ENV=prod` also needs STAREXEC_DB_PASSWORD set, so
  # export the same value.
  password: <your-dev-password>
  database: starexec
  rootPassword: <your-dev-root-password>

  persistence:
    enabled: true

backend:
  type: "podman"
  root: "/app/backend"
  workingDir: "/app/work"
  networkMode: "starexec-net"
  jobDbHost: "postgres"
  local:
    concurrency: 1
    forceSandbox: true
    useRunsolver: true
    gracefulShutdownSeconds: 30

dataDir: "/app/data"
sandboxDir: "/app/sandbox"

env:
  LOG_LEVEL: "DEBUG"
  FLYWAY_BASELINE_ON_MIGRATE: "true"
  STAREXEC_WEB_ADDRESS: "localhost:7827"
  STAREXEC_URL_PREFIX: "http"

podman:
  containerSocket:
    enabled: true
    # Rootless Podman socket path placeholder.
    # `make start` resolves the active socket path for the current user and overrides this
    # value at render time. You only need to edit this field when invoking Helm directly or
    # when you want the values file itself to reflect a nonstandard socket location.
    # For direct Helm with rootless Podman, inject the socket gid via
    # security.pod.supplementalGroups so the fixed in-image app user can open it.
    # Deployment still fails if the resolved socket is missing or not responding.
    # See docs/TROUBLESHOOTING.md#podman-issues for detailed remediation steps.
    hostPath: "/run/user/1000/podman/podman.sock"
  jobImage: "ghcr.io/starexecmiami/starexec-job-runner:latest"
  # Keep one concurrent job to reduce L1/L2 cache contention.
  maxConcurrentJobs: 1
