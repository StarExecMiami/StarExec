<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Emit internal Logback status messages to console (helps verify pattern parsing) -->
  <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener"/>
  <!-- Pattern: one line per event; short exception (root cause) on next line if present -->
  <property name="APP_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n%ex{short}"/>
  <property name="APP_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n%rEx%n"/>

  <appender name="STAREXEC" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <Append>true</Append>
    <File>@STAREXEC_LOG@</File>
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <pattern>${APP_PATTERN}</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>@STAREXEC_LOG@.%d</fileNamePattern>
      <maxHistory>14</maxHistory>
    </rollingPolicy>
  </appender>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${APP_PATTERN}</pattern>
    </encoder>
  </appender>

  <!-- Reduce noise from 3rd party libs (can tweak later) -->
  <logger name="org.hibernate" level="WARN"/>
  <logger name="org.springframework" level="INFO"/>

  <!-- Force app internal logging to DEBUG for richer diagnostics -->
  <logger name="org.starexec" level="DEBUG" additivity="true"/>

  <!-- Suppress excessive per-request DEBUG noise from session/auth plumbing -->
  <logger name="org.starexec.app.SessionFilter" level="INFO"/>
  <logger name="org.starexec.util.SessionUtil" level="INFO"/>
  <logger name="org.starexec.data.database.Permissions" level="INFO"/>

  <root level="@LOGGING_LEVEL@">
    <appender-ref ref="STAREXEC"/>
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>