<Context>
  <!-- Disable persistent sessions -->
  <Manager className="org.apache.catalina.session.StandardManager" pathname=""/>

  <!-- JNDI DataSource used by DataSourceRealm -->
  <Resource name="jdbc/StarExecDB"
            auth="Container"
            type="javax.sql.DataSource"
            factory="org.apache.tomcat.jdbc.pool.DataSourceFactory"
            driverClassName="org.postgresql.Driver"
            url="jdbc:postgresql://${env.STAREXEC_DB_HOST}:${env.STAREXEC_DB_PORT}/${env.STAREXEC_DB_NAME}?ssl=false&amp;currentSchema=starexec"
            username="${env.STAREXEC_DB_USER}"
            password="${env.STAREXEC_DB_PASSWORD}"
            maxActive="20"
            maxIdle="10"
            maxWait="10000"
            validationQuery="SELECT 1"
            testOnBorrow="true"/>

  <!-- Use PostgreSQL users/roles for container-managed auth (FORM j_security_check) -->
  <Realm className="org.apache.catalina.realm.LockOutRealm">
    <Realm className="org.apache.catalina.realm.DataSourceRealm"
            dataSourceName="jdbc/StarExecDB"
            localDataSource="true"
            userTable="users"
            userNameCol="email"
            userCredCol="password"
            userRoleTable="user_roles"
            roleNameCol="role">
            <CredentialHandler className="org.apache.catalina.realm.MessageDigestCredentialHandler"
                          algorithm="SHA-512"/>
    </Realm>
  </Realm>

  <!-- Legacy cookie processor to match app expectations -->
  <CookieProcessor className="org.apache.tomcat.util.http.Rfc6265CookieProcessor" sameSiteCookies="lax" />
</Context>
