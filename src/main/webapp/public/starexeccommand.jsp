<%@page contentType="text/html" pageEncoding="UTF-8" %>
<%@taglib prefix="star" tagdir="/WEB-INF/tags" %>
<star:template title="StarExecCommand" css="about">
	<main role="main" class="starexeccommand-container">
		<section aria-labelledby="starexeccommand-heading">
			<h1 id="starexeccommand-heading" class="sr-only">StarExecCommand</h1>
			<p>
				StarExecCommand is a Java program that allows users to make requests of
				the StarExec server from a command prompt.
				Documentation can be found in the archive, and is also available <a
					href="${starexecRoot}/public/manual.txt" rel="help">here</a>
			</p>

			<p><a href="${starexecRoot}/public/starexeccommand.zip" rel="external">Download
				StarExecCommand</a></p>
		</section>
	</main>
</star:template>
