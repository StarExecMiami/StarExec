#!/bin/bash
#==========================================================================
# Standard SGE job script setup.
#==========================================================================

# The queue to submit to
#$ -q $$QUEUE$$
#OAR -q $$QUEUE$$
#OAR -p queue='$$QUEUE$$'

# Enable resource limit signals
#$ -notify

# Submit under sandbox user
#$ -u $$SANDBOX_USER_ONE$$

# Resource limits
#$ -l s_fsize=$$MAX_WRITE$$G

# Default shell is bash
#$ -S /bin/bash

# Merge stdout and stderr streams
#$ -j y

export readonly BENCHEXEC='BENCHEXEC'
export readonly RUNSOLVER='RUNSOLVER'

export BENCH_NAME_LENGTH_LIMIT='$$BENCH_NAME_LENGTH_MAX$$'
export PRIMARY_PREPROCESSOR_PATH='$$PRIMARY_PREPROCESSOR_PATH$$'
export NUM_SLOTS='$$NUM_SLOTS$$'
export RAND_SEED='$$RANDSEED$$'
export MAX_MEM='$$MAX_MEM$$'
export BENCH_SAVE_DIR='$$BENCH_SAVE_PATH$$'
export USER_ID='$$USERID$$'
export HAS_DEPENDS='$$HAS_DEPENDS$$'
export BENCH_PATH='$$BENCH$$'
export PAIR_ID='$$PAIRID$$'
export STAREXEC_MAX_WRITE='$$MAX_WRITE$$'
export STAREXEC_CPU_LIMIT='$$MAX_CPUTIME$$'
export STAREXEC_WALLCLOCK_LIMIT='$$MAX_RUNTIME$$'
export SOFT_TIME_LIMIT='$$SOFT_TIME_LIMIT$$'
export KILL_DELAY='$$KILL_DELAY$$'
export REPORT_HOST='$$REPORT_HOST$$'
export SHARED_DIR='$$STAREXEC_DATA_DIR$$'
export SPACE_PATH='$$SPACE_PATH$$'
export SCRIPT_PATH='$$SCRIPT_PATH$$'
export PAIR_OUTPUT_DIRECTORY='$$PAIR_OUTPUT_DIRECTORY$$'
export DB_NAME='$$DB_NAME$$'
export BUILD_JOB='$$BUILD_JOB$$'
export WORKING_DIR_BASE='$$WORKING_DIR_BASE$$'
export BENCH_ID='$$BENCH_ID$$'
export SANDBOX_USER_ONE='$$SANDBOX_USER_ONE$$'
export SANDBOX_USER_TWO='$$SANDBOX_USER_TWO$$'
export DISK_QUOTA='$$DISK_QUOTA$$'
export DISK_QUOTA_EXCEEDED=0
# DB username and password for status reporting
export DB_USER="$$DB_USER$$"
export DB_PASS="$$DB_PASS$$"
export SCRIPT_DIR="$$SCRIPT_DIR$$"

export BENCHMARKING_FRAMEWORK="$$BENCHMARKING_FRAMEWORK$$"

# Container mode detection - set by LocalBackend when running in Docker/Podman/Kubernetes
# When true, job scripts skip sudo and use direct execution since containers provide isolation
export CONTAINER_MODE="${CONTAINER_MODE:-false}"

# Defence in depth for the DB credentials exported above. JobManager already declines to
# substitute them for the Kubernetes and Podman backends, but CONTAINER_MODE is a runtime
# signal and LocalBackend sets it too when it runs inside a container, so scrub here as
# well rather than relying on the writer having known.
#
# Nothing is lost: functions.bash dbExec returns early under isContainerMode and the
# job-runner image ships no psql. What is gained is that the solver -- untrusted
# third-party code, started as a direct child of this shell with no `sudo -u` to reset the
# environment in container mode -- does not inherit StarExec's database credentials.
if [ "$CONTAINER_MODE" = "true" ]; then
	unset DB_USER
	unset DB_PASS
fi

# Path to Olivier Roussel's runSolver
export RUNSOLVER_PATH='$$RUNSOLVER_PATH$$'

# Include common functions and status codes
. "$SCRIPT_DIR/functions.bash"


# Array of secondary benchmarks starexec paths
# BUG FIX: bash 5.3 changed nounset semantics — `declare -a arr` without assignment
# is treated as "unbound" inside functions under `set -u`, causing
# "BENCH_DEPENDS_ARRAY: unbound variable" at checkIfBenchmarkDependenciesExists.
# Using `arr=()` (explicit empty assignment) satisfies nounset in all bash versions.
BENCH_DEPENDS_ARRAY=()

# Array of secondary benchmarks execution host paths
LOCAL_DEPENDS_ARRAY=()

#==========================================================================
# Arrays of stage information written from Java
#
#
#==========================================================================

$$STAGE_NUMBER_ARRAY$$

$$CPU_TIMEOUT_ARRAY$$

$$CLOCK_TIMEOUT_ARRAY$$

$$MEM_LIMIT_ARRAY$$

$$SOLVER_ID_ARRAY$$

$$SOLVER_TIMESTAMP_ARRAY$$

$$CONFIG_NAME_ARRAY$$

$$PRE_PROCESSOR_PATH_ARRAY$$
$$PRE_PROCESSOR_TIME_LIMIT_ARRAY$$

$$POST_PROCESSOR_PATH_ARRAY$$
$$POST_PROCESSOR_TIME_LIMIT_ARRAY$$

$$SPACE_ID_ARRAY$$

$$SOLVER_NAME_ARRAY$$

$$SOLVER_PATH_ARRAY$$

$$BENCH_INPUT_ARRAY$$

$$BENCH_SUFFIX_ARRAY$$

$$RESULTS_INTERVAL_ARRAY$$

$$STDOUT_SAVE_OPTION_ARRAY$$

$$EXTRA_SAVE_OPTION_ARRAY$$

NUM_STAGES=${#STAGE_NUMBERS[@]}

# BUG FIX: Using $((  )) arithmetic expansion instead of (( )) compound command.
# With `set -euo pipefail` (set in functions.bash), `(( expr ))` returns exit code 1
# when the result is 0, which aborts the script BEFORE the EXIT trap is registered
# (trap 'exitJobscript $?' EXIT is set below). When BENCH_INPUT_PATHS has only the
# terminating empty string, ${#BENCH_INPUT_PATHS[@]} - 1 == 0, causing all jobs with
# no benchmark inputs to silently exit without writing status.json, leaving pairs
# stuck in ENQUEUED status forever.
NUM_BENCH_INPUTS=$(( ${#BENCH_INPUT_PATHS[@]} - 1 )) # we terminate the array with an empty string, so the number is the size-1



#==========================================================================
# Signal Traps
#
# These are just for the limits we are asking SGE to enforce.
# For the ones runsolver is enforcing, we will look in the
# watcher.out file.
#==========================================================================

trap "limitExceeded 'file write' $EXCEED_FILE_WRITE" SIGXFSZ
trap 'echo "Jobscript received USR2."' USR2
trap 'exitJobscript $?' EXIT

#==========================================================================
# Execute (prolog will take care of data staging)
#==========================================================================


echo "STAREXEC Job Log"
echo "(C) $(date +%Y) The University of Miami"
echo "====================================="
echo "date: $(date)"
echo "user: $USER_ID"
echo "pair id: $PAIR_ID"
echo "solver ids: ${SOLVER_IDS[*]}"
echo "benchmark id: $BENCH_ID"
echo "execution host: $HOSTNAME"
echo "benchmarking framework: $BENCHMARKING_FRAMEWORK"
echo "whoami: $(whoami)"
adjustForK8s

if [ "$BENCHMARKING_FRAMEWORK" == "$BENCHEXEC" ]; then
	log "Using benchexec."
else
	log "Using runsolver."
fi

if [ $BUILD_JOB == "true" ]; then
	echo "This is a solver build job"
fi

echo ""

# The stage loop below owns STAGE_INDEX, but sendNode reads STAGE_NUMBERS[STAGE_INDEX]
# from inside initSandbox, before the loop has run. Stage 0 is the first stage that will
# run, which is what the pair's initial RUNNING status should name.
STAGE_INDEX=0

initSandbox
initWorkspaceVariables
cleanWorkspace 1
setStartTime

createLocalTmpDirectory

log "there are this many benchmark inputs $NUM_BENCH_INPUTS"

decodePathArrays

$$STAGE_DEPENDENCY_ARRAY$$
fillDependArrays

if ! checkIfBenchmarkDependenciesExists; then
	log "Missing benchmark dependencies, aborting."
	sendStatus "$ERROR_BENCH_DEPENDENCY_MISSING"
	exit 0
fi
log "All benchmark dependencies verified."
#todo: alter the way we copy runsolver over so it only happens once
copyBenchmarkDependencies

#==============================================================================
# This is the start of the loop that runs for each stage
#
#
#==============================================================================


# directory containing all the output files from a solver. This won't exist until the second stage
# and onwards
OTHER_INPUT_PATH=""

# if we are using pipelines, the OTHER_INPUT_PATH should always exist.
# so, we start with an empty directory here
if ((NUM_STAGES > 1)); then
	mkdir "$OUT_DIR"/empty_output_dir
	OTHER_INPUT_PATH="$OUT_DIR"/empty_output_dir
fi

log "the number of stages is $NUM_STAGES"

for (( STAGE_INDEX = 0; STAGE_INDEX < NUM_STAGES; ++STAGE_INDEX )); do
	# The stage this iteration runs, named before anything that can fail. The setup below --
	# checkCache, copyDependencies, verifyWorkspace, sandboxWorkspace -- prepares THIS stage, so
	# a failure in it belongs to this stage and not to the pair (#145).
	CURRENT_STAGE_NUMBER=${STAGE_NUMBERS[STAGE_INDEX]}
	CURRENT_STAGE_MEMORY=$MAX_MEM   #start with the default max mem
	CURRENT_STAGE_CPU=$STAREXEC_CPU_LIMIT
	CURRENT_STAGE_WALLCLOCK=$STAREXEC_WALLCLOCK_LIMIT

	if ((CURRENT_STAGE_MEMORY > "${STAGE_MEM_LIMITS[STAGE_INDEX]}")); then
		CURRENT_STAGE_MEMORY=${STAGE_MEM_LIMITS[STAGE_INDEX]}
	fi

	if ((CURRENT_STAGE_CPU > "${STAGE_CPU_TIMEOUTS[STAGE_INDEX]}")); then
		CURRENT_STAGE_CPU=${STAGE_CPU_TIMEOUTS[STAGE_INDEX]}
	fi

	if ((CURRENT_STAGE_WALLCLOCK > "${STAGE_CLOCK_TIMEOUTS[STAGE_INDEX]}")); then
		CURRENT_STAGE_WALLCLOCK=${STAGE_CLOCK_TIMEOUTS[STAGE_INDEX]}
	fi

	POST_PROCESSOR_PATH=${POST_PROCESSOR_PATHS[STAGE_INDEX]}
	POST_PROCESSOR_TIME_LIMIT=${POST_PROCESSOR_TIME_LIMITS[STAGE_INDEX]}

	PRE_PROCESSOR_PATH=${PRE_PROCESSOR_PATHS[STAGE_INDEX]}
	PRE_PROCESSOR_TIME_LIMIT=${PRE_PROCESSOR_TIME_LIMITS[STAGE_INDEX]}

	CONFIG_NAME=${CONFIG_NAMES[STAGE_INDEX]}
	SOLVER_NAME=${SOLVER_NAMES[STAGE_INDEX]}
	SOLVER_PATH=${SOLVER_PATHS[STAGE_INDEX]}
	SOLVER_ID=${SOLVER_IDS[STAGE_INDEX]}
	SOLVER_TIMESTAMP=${SOLVER_TIMESTAMPS[STAGE_INDEX]}
	SPACE_ID=${SPACE_IDS[STAGE_INDEX]}
	ARGUMENT_STRING=${STAGE_DEPENDENCIES[STAGE_INDEX]}
	CURRENT_BENCH_SUFFIX=${BENCH_SUFFIXES[STAGE_INDEX]}
	SUPPRESS_TIMESTAMP=$$SUPPRESS_TIMESTAMP_OPTION$$
	RESULTS_INTERVAL=${RESULTS_INTERVALS[STAGE_INDEX]}
	STDOUT_SAVE_OPTION=${STDOUT_SAVE_OPTIONS[STAGE_INDEX]}
	EXTRA_SAVE_OPTION=${EXTRA_SAVE_OPTIONS[STAGE_INDEX]}

	#path to where cached solvers are stored
	SOLVER_CACHE_PATH="$WORKING_DIR_BASE/solvercache/$SOLVER_TIMESTAMP/$SOLVER_ID"

	#whether the solver was found in the cache
	SOLVER_CACHED=0

	if [ $BUILD_JOB == "true" ]; then
		LOCAL_CONFIG_PATH="$LOCAL_SOLVER_DIR/starexec_build"
	else
		# The path to the config run script on the execution host
		LOCAL_CONFIG_PATH="$LOCAL_SOLVER_DIR/bin/starexec_run_$CONFIG_NAME"
	fi

	SOFT_TIME_LIMIT_FLAG=""
	if [ $SOFT_TIME_LIMIT -ne 0 ]; then
		SOFT_TIME_LIMIT_FLAG="--softtimelimit $SOFT_TIME_LIMIT"
	fi

	KILL_DELAY_FLAG=""
	if [ $KILL_DELAY -ne 0 ]; then
		KILL_DELAY_FLAG="-d $KILL_DELAY"
	fi

	createDir "$OUT_DIR/output_files"
	chmod g+w "$OUT_DIR/output_files"

	#Give job pairs 2 extra minutes before we kill them.
	JOB_PAIR_EXTRA_TIME=120

	# B7: copyDependencies (pre-processor, below) and copyOutput (post-processor, later
	# this stage) each run their own processor under
	# `timeout --signal=SIGKILL $((LIMIT))m`, but LIMIT is reachable as 0 -- a nullable
	# column, and 0 is an intentional "no limit" state the product already allows (#229)
	# -- and `timeout ... 0m` enforces no bound at all. Neither phase was covered by the
	# defensive killDeadlockedJobPair watchdog below, which used to start only after
	# both had already run, so an unbounded pre/post-processor could wedge the job slot
	# forever. Start the watchdog here instead, before either phase, and size its sleep
	# to cover both: an unbounded (0) processor still gets the same ceiling an admin can
	# set in the UI (edit/processor.jsp max="60"), so the slot is always eventually
	# reclaimed without cutting short an ordinary bounded pre/post-processor run.
	#
	# This reclaim only actually reaches the processor in CONTAINER_MODE. There,
	# initSandbox/sandboxWorkspace run everything -- pre-processor, solver, and
	# post-processor alike -- as one user, the same one killDeadlockedJobPair's
	# `killall --user $SANDBOX_PARAM` targets. Under legacy (non-container/SGE)
	# execution, the solver is explicitly `sudo -u $SANDBOX_PARAM`'d but the pre/post
	# processor invocations below are not, so a hung processor there runs as the
	# jobscript's own user and this watchdog cannot reach it -- pre-existing, and out
	# of scope for this fix; Local/Podman/Kubernetes (this project's active backends)
	# always run CONTAINER_MODE=true.
	PROCESSOR_FALLBACK_LIMIT_SECS=$((60 * 60))

	PRE_PROCESSOR_BUDGET_SECS=0
	if [ -n "${PRE_PROCESSOR_PATH:-}" ]; then
		if ((PRE_PROCESSOR_TIME_LIMIT > 0)); then
			PRE_PROCESSOR_BUDGET_SECS=$((PRE_PROCESSOR_TIME_LIMIT * 60))
		else
			PRE_PROCESSOR_BUDGET_SECS=$PROCESSOR_FALLBACK_LIMIT_SECS
		fi
	fi

	POST_PROCESSOR_BUDGET_SECS=0
	if [ -n "${POST_PROCESSOR_PATH:-}" ]; then
		if ((POST_PROCESSOR_TIME_LIMIT > 0)); then
			POST_PROCESSOR_BUDGET_SECS=$((POST_PROCESSOR_TIME_LIMIT * 60))
		else
			POST_PROCESSOR_BUDGET_SECS=$PROCESSOR_FALLBACK_LIMIT_SECS
		fi
	fi

	STAGE_WATCHDOG_TIMEOUT=$((PRE_PROCESSOR_BUDGET_SECS + CURRENT_STAGE_WALLCLOCK + POST_PROCESSOR_BUDGET_SECS))

	log "pre processor watchdog budget (s) : $PRE_PROCESSOR_BUDGET_SECS"
	log "post processor watchdog budget (s) : $POST_PROCESSOR_BUDGET_SECS"
	log "combined stage watchdog timeout (s) : $STAGE_WATCHDOG_TIMEOUT"

	# this will be set to true below if the job pair gets deadlocked
	echo "Calling killDeadlockedJobPair"

	killDeadlockedJobPair "$STAGE_WATCHDOG_TIMEOUT" "$JOB_PAIR_EXTRA_TIME" "$SANDBOX_PARAM" &
	# Get the process of our defensive killDeadlockedJobPair function.
	KILL_DEADLOCKED_JOB_PAIR_PID=$!
	echo "KILL_DEADLOCKED_JOB_PAIR_PID = $KILL_DEADLOCKED_JOB_PAIR_PID"

	checkCache
	copyDependencies
	verifyWorkspace
	sandboxWorkspace

	log "listing contents of sandbox..."
	ls -lR "$WORKING_DIR"

	log "doing stage index $STAGE_INDEX"
	log "stage number : $CURRENT_STAGE_NUMBER"
	log "cpu timeout : $CURRENT_STAGE_CPU"
	log "clock timeout : $CURRENT_STAGE_WALLCLOCK"
	log "global cpu timeout : $STAREXEC_CPU_LIMIT"
	log "global wallclock timeout : $STAREXEC_WALLCLOCK_LIMIT"
	log "extra time for job pair after wallclock timeout : $JOB_PAIR_EXTRA_TIME"
	log "mem limit : $CURRENT_STAGE_MEMORY"
	log "solver id : $SOLVER_ID"
	log "solver name : $SOLVER_NAME"
	log "solver path : $SOLVER_PATH"
	log "solver timestamp : $SOLVER_TIMESTAMP"
	log "config name : $CONFIG_NAME"
	log "pre processor path : $PRE_PROCESSOR_PATH"
	log "post processor path : $POST_PROCESSOR_PATH"
	log "space id : $SPACE_ID"
	log "bench path : $BENCH_PATH"
	log "benchmark suffix : $CURRENT_BENCH_SUFFIX"
	log "argument string : $ARGUMENT_STRING"
	log "results interval : $RESULTS_INTERVAL"
	log "stdout save option : $STDOUT_SAVE_OPTION"
	log "additional output save option : $EXTRA_SAVE_OPTION"
	log "user disk quota : $DISK_QUOTA"

	log "whoami: $(whoami)"

	if ((RESULTS_INTERVAL > 0)); then
		copyOutputIncrementally "$RESULTS_INTERVAL" "$STAREXEC_WALLCLOCK_LIMIT" "$CURRENT_STAGE_NUMBER" "$STDOUT_SAVE_OPTION" "$EXTRA_SAVE_OPTION" &
		COPY_OUTPUT_INCREMENTALLY_PID=$!
	fi

	if [ $BUILD_JOB == "true" ]; then
		cd $WORKING_DIR/solver
		rm -f "$LOCAL_BENCH_PATH"
		LOCAL_BENCH_PATH=""
	else
		cd $WORKING_DIR/solver/bin
	fi

	pwd

	log "listing contents of the output directory"
	ls -l "$OUT_DIR"

	if [ "$BENCHMARKING_FRAMEWORK" == "$BENCHEXEC" ]; then
		MEM_IN_BYTES=$(( CURRENT_STAGE_MEMORY * 1000000 ))

		log "Setting up cpuset cgroup..."
		echo $$ > /sys/fs/cgroup/cpuset/system.slice/benchexec-cgroup.service/tasks
		log "Setting up cpuacct cgroup..."
		echo $$ > /sys/fs/cgroup/cpuacct/system.slice/benchexec-cgroup.service/tasks
		log "Setting up memory cgroup..."
		echo $$ > /sys/fs/cgroup/memory/system.slice/benchexec-cgroup.service/tasks
		log "Setting up freezer cgroup..."
		echo $$ > /sys/fs/cgroup/freezer/system.slice/benchexec-cgroup.service/tasks

		log "Running runexec."
		echo "runexec --no-container --memlimit $MEM_IN_BYTES --timelimit $CURRENT_STAGE_CPU --walltimelimit $CURRENT_STAGE_WALLCLOCK $SOFT_TIME_LIMIT_FLAG --cores $CORES --output $STDOUT_FILE $LOCAL_CONFIG_PATH $LOCAL_BENCH_PATH $OUT_DIR/output_files $OTHER_INPUT_PATH $ARGUMENT_STRING"

		# Run runexec, runexec will output the stdout of the solver to $OUT_DIR/stdout.txt and will output statistics to $OUT_DIR/var.out
		# In container mode, we don't use sudo since containers provide isolation
		if isContainerMode; then
			TMPDIR="$LOCAL_TMP_DIR" STAREXEC_MAX_MEM="$CURRENT_STAGE_MEMORY" STAREXEC_MAX_WRITE=$$MAX_WRITE$$ STAREXEC_CPU_LIMIT="$CURRENT_STAGE_CPU" STAREXEC_WALLCLOCK_LIMIT="$CURRENT_STAGE_WALLCLOCK" $$JOBPAR_EXECUTION_PREFIX$$ runexec --no-container --memlimit $MEM_IN_BYTES --timelimit $CURRENT_STAGE_CPU --walltimelimit $CURRENT_STAGE_WALLCLOCK $SOFT_TIME_LIMIT_FLAG --cores $CORES --output "$STDOUT_FILE" "$LOCAL_CONFIG_PATH" "$LOCAL_BENCH_PATH" "$OUT_DIR/output_files" $OTHER_INPUT_PATH $ARGUMENT_STRING > "$VARFILE"
		else
			sudo -u $SANDBOX_PARAM TMPDIR="$LOCAL_TMP_DIR" STAREXEC_MAX_MEM="$CURRENT_STAGE_MEMORY" STAREXEC_MAX_WRITE=$$MAX_WRITE$$ STAREXEC_CPU_LIMIT="$CURRENT_STAGE_CPU" STAREXEC_WALLCLOCK_LIMIT="$CURRENT_STAGE_WALLCLOCK" $$JOBPAR_EXECUTION_PREFIX$$ runexec --no-container --memlimit $MEM_IN_BYTES --timelimit $CURRENT_STAGE_CPU --walltimelimit $CURRENT_STAGE_WALLCLOCK $SOFT_TIME_LIMIT_FLAG --cores $CORES --output "$STDOUT_FILE" "$LOCAL_CONFIG_PATH" "$LOCAL_BENCH_PATH" "$OUT_DIR/output_files" $OTHER_INPUT_PATH $ARGUMENT_STRING > "$VARFILE"
		fi

		# make a blank watchfile
		touch "$WATCHFILE"
	elif [ "$BENCHMARKING_FRAMEWORK" == "$RUNSOLVER" ]; then
	# run runsolver

	# In containerized environments, runsolver --timestamp and --add-eof flags cause "unimplemented" errors
	# Always suppress timestamps to avoid this issue in Docker/Podman/Kubernetes
	if [ "$SUPPRESS_TIMESTAMP" = true ] || isContainerMode || [ -f /.dockerenv ] || [ -f /run/.containerenv ] || grep -qE 'docker|kubepods|containerd' /proc/1/cgroup 2>/dev/null; then
		log "Suppressing timestamp (containerized environment or user preference)."
		SUPPRESS_TIMESTAMP=true
		TIMESTAMP_PARAM=""
		ADDEOF_PARAM=""
	else
		log "Not suppressing timestamp."
		TIMESTAMP_PARAM="--timestamp"
		ADDEOF_PARAM="--add-eof"
	fi		# If $WORKING_DIR/solver/bin/run_image.py exists, we use it instead of runsolver.
		# Also, in this case, we're using the local backend, so this jobscript is actually running on the
		# head node of starexec. (this run_image without k8s is likely buggy and should be considered deprecated.)
		if [ -f "$WORKING_DIR/solver/bin/run_image.py" ]; then
			# Run a theorem proving image: https://www.eprover.org/EVENTS/IWIL-2024/IWIL-24-Preproceedings.pdf
			# get prover tag:
			PROVER=$(cat "$WORKING_DIR/solver/bin/prover.txt")

			# sandbox or sandbox2
			if [[ $SANDBOX_PARAM =~ ([0-9])$ ]]; then
				SANDBOX_NUM=${BASH_REMATCH[1]}
			else
				SANDBOX_NUM=1
			fi

			# Use SANDBOX_NUM in your command
			RUNIMAGE_CMD="python3 \"$WORKING_DIR/solver/bin/run_image.py\" \"$PROVER\" \
							-P \"$LOCAL_BENCH_PATH\" \
							-C $CURRENT_STAGE_CPU \
							-W $CURRENT_STAGE_WALLCLOCK \
							-M \"$CURRENT_STAGE_MEMORY\" \
							--starexec=$SANDBOX_NUM"

			log "Running run_image.py: $RUNIMAGE_CMD"
			eval "$RUNIMAGE_CMD"

		elif [ -f "$WORKING_DIR/solver/bin/run_image_k8s.py" ]; then
			# Run a theorem proving image: https://www.eprover.org/EVENTS/IWIL-2024/IWIL-24-Preproceedings.pdf
			# in kubernettes instead of podman remote. Assumes kubectl is working in the container.

			# get prover tag:
			PROVER=$(cat "$WORKING_DIR/solver/bin/prover.txt")

			RUNIMAGE_CMD="python3 \"$WORKING_DIR/solver/bin/run_image_k8s.py\" \"$PROVER\" \
							-P \"$LOCAL_BENCH_PATH\" \
							-C $CURRENT_STAGE_CPU \
							-W $CURRENT_STAGE_WALLCLOCK \
							-M \"$CURRENT_STAGE_MEMORY\" \
							--sandbox=\"$WORKING_DIR\" \
							--job-template-path=\"$WORKING_DIR/solver/bin/job_template.yaml\" "

			log "Running run_image_k8s.py: $RUNIMAGE_CMD"
			eval "$RUNIMAGE_CMD"

		else
			# Assemble the runsolver command, including placeholders that will be dynamically replaced
			# In container mode, we don't use sudo since containers provide isolation
			if isContainerMode; then
				RUNSOLVER_CMD="TMPDIR=\"$LOCAL_TMP_DIR\" \
					STAREXEC_MAX_MEM=\"$CURRENT_STAGE_MEMORY\" \
					STAREXEC_MAX_WRITE=$$MAX_WRITE$$ \
					STAREXEC_CPU_LIMIT=\"$CURRENT_STAGE_CPU\" \
					STAREXEC_WALLCLOCK_LIMIT=\"$CURRENT_STAGE_WALLCLOCK\" \
					$$JOBPAR_EXECUTION_PREFIX$$ \"$LOCAL_RUNSOLVER_PATH\" \
					$TIMESTAMP_PARAM $ADDEOF_PARAM \
					-C $CURRENT_STAGE_CPU \
					-W $CURRENT_STAGE_WALLCLOCK \
					$KILL_DELAY_FLAG \
			-M $CURRENT_STAGE_MEMORY \
				-w \"$WATCHFILE\" -v \"$VARFILE\" -o \"$STDOUT_FILE\" \
				\"$LOCAL_CONFIG_PATH\" \
				\"$LOCAL_BENCH_PATH\" \
				\"$OUT_DIR/output_files\" \
				\"$OTHER_INPUT_PATH\" \
				$ARGUMENT_STRING"
		else
			RUNSOLVER_CMD="sudo -u $SANDBOX_PARAM TMPDIR=\"$LOCAL_TMP_DIR\" \
				STAREXEC_MAX_MEM=\"$CURRENT_STAGE_MEMORY\" \
				STAREXEC_MAX_WRITE=$$MAX_WRITE$$ \
				STAREXEC_CPU_LIMIT=\"$CURRENT_STAGE_CPU\" \
				STAREXEC_WALLCLOCK_LIMIT=\"$CURRENT_STAGE_WALLCLOCK\" \
				$$JOBPAR_EXECUTION_PREFIX$$ \"$LOCAL_RUNSOLVER_PATH\" \
				$TIMESTAMP_PARAM $ADDEOF_PARAM \
				-C $CURRENT_STAGE_CPU \
				-W $CURRENT_STAGE_WALLCLOCK \
				$KILL_DELAY_FLAG \
				-M $CURRENT_STAGE_MEMORY \
					-w \"$WATCHFILE\" -v \"$VARFILE\" -o \"$STDOUT_FILE\" \
					\"$LOCAL_CONFIG_PATH\" \
					\"$LOCAL_BENCH_PATH\" \
					\"$OUT_DIR/output_files\" \
					\"$OTHER_INPUT_PATH\" \
					$ARGUMENT_STRING"
			fi

			# Log and run the command
			log "Running runsolver: $RUNSOLVER_CMD"
			eval "$RUNSOLVER_CMD"
		fi
	fi


	# move the working directory back to the top level sandbox
	cd $WORKING_DIR
	if ((RESULTS_INTERVAL > 0)); then
		# suppress set -e: background process may already be dead
		kill $COPY_OUTPUT_INCREMENTALLY_PID 2>/dev/null || true
	fi

	# B7: the watchdog started before this stage's pre-processor now also has to
	# outlive this point, to cover the post-processor phase still ahead (copyOutput
	# below) -- so only PROBE its liveness here with `kill -0` (sends no signal)
	# instead of ending it. The real kill happens once this stage's post-processing
	# is done (stopDeadlockWatchdog, right after the copyOutput call below), and
	# again from exitJobscript as a safety net for every early-exit path in between.
	log "Runsolver finished. Checking whether the defensive killall function already fired."
	JOB_PAIR_DEADLOCKED=false
	if ! kill -0 "$KILL_DEADLOCKED_JOB_PAIR_PID" 2>/dev/null; then
		log "Job pair was deadlocked (killDeadlockedJobPair already ran)."
		JOB_PAIR_DEADLOCKED=true
	fi

	log "listing contents of the output directory recursively"
	ls -lhR "$OUT_DIR"

	log "recording header of job pair output"
	# suppress set -e: file may be empty or missing if solver produced no output
	head -5 "$STDOUT_FILE" || true

	if [ ! -s "$VARFILE" ]; then
		echo "Varfile could not be found. Terminating job pair."
		copyOutputNoStats "$CURRENT_STAGE_NUMBER" "$STDOUT_SAVE_OPTION" "$EXTRA_SAVE_OPTION" "$BENCHMARKING_FRAMEWORK"
		markRunscriptError "${STAGE_NUMBERS[STAGE_INDEX]}"
		exit 0
	fi

	if [[ "$BENCHMARKING_FRAMEWORK" == "$RUNSOLVER" ]] && [[ ! -s "$WATCHFILE" ]]; then
		log "Runsolver watchfile could not be found. Terminating job pair."
		# Without the watchfile there are no statistics to read from it, and copyOutput reads it:
		# under set -e that ended the pair before markRunscriptError below, as it did for the
		# missing varfile above (#145).
		copyOutputNoStats "$CURRENT_STAGE_NUMBER" "$STDOUT_SAVE_OPTION" "$EXTRA_SAVE_OPTION" "$BENCHMARKING_FRAMEWORK"
		markRunscriptError "${STAGE_NUMBERS[STAGE_INDEX]}"
		exit 0
	fi

	if ! isOutputValid "$STDOUT_FILE" "$CURRENT_STAGE_NUMBER" "$SUPPRESS_TIMESTAMP" "$BENCHMARKING_FRAMEWORK" ; then
		log "runsolver output was not valid. Terminating job pair."
		markRunscriptError "${STAGE_NUMBERS[STAGE_INDEX]}"
		exit 0
	fi

	# check for which cores we are on
	log "epilog checking for information on cores, from runsolver's watch file:"
	# BUG FIX: grep returns exit code 1 when no match is found. With set -e that
	# aborts the script. "cores:" is absent in container mode (SUPPRESS_TIMESTAMP).
	grep 'cores:' "$WATCHFILE" || true

	# this also does post processing
	copyOutput "$CURRENT_STAGE_NUMBER" "$STDOUT_SAVE_OPTION" "$EXTRA_SAVE_OPTION" "$BENCHMARKING_FRAMEWORK"
	# B7: the post-processor above just ran under the watchdog started before this
	# stage's pre-processor; this stage no longer needs it.
	stopDeadlockWatchdog

	if ((STDOUT_SAVE_OPTION == 3)); then
		saveStdoutAsBenchmark
	fi

	if ((EXTRA_SAVE_OPTION == 3)); then
		saveExtraOutputAsBenchmarks
	fi

	ERROR_DETECTED=false

	if [ "$BENCHMARKING_FRAMEWORK" == "$BENCHEXEC" ]; then
		log "Checking for errors for benchexec."
		if (grep 'terminationreason=cputime' "$VARFILE") then
			sendCpuExceededStatus
			ERROR_DETECTED=true
		elif (grep 'terminationreason=walltime' "$VARFILE") || [ "$JOB_PAIR_DEADLOCKED" = true ]; then
			sendWallclockExceededStatus
			ERROR_DETECTED=true
		elif (grep 'terminationreason=memory' "$VARFILE") then
			sendExceedMemStatus
			ERROR_DETECTED=true
		elif (grep 'terminationreason=' "$VARFILE") then
			# generic case for failure
			ERROR_DETECTED=true
		fi
	elif [ "$BENCHMARKING_FRAMEWORK" == "$RUNSOLVER" ]; then
		log "Checking for errors for runsolver."
		# SGE_STDOUT_PATH only exists under Grid Engine; in container mode use WATCHFILE.
		_err_source="${SGE_STDOUT_PATH:-$WATCHFILE}"
		
		# Mitigate I/O race condition: wait up to 2 seconds for the kernel to flush buffers
		# after runsolver process termination. This is safer than a global 'sync'.
		for i in {1..20}; do
			if [ -s "$_err_source" ]; then
				break
			fi
			sleep 0.1
		done

		if [ -s "$_err_source" ] && grep -q 'job error:' "$_err_source"; then
			ERROR_DETECTED=true
		elif (grep 'CPU time exceeded' "$WATCHFILE" ) then
			sendCpuExceededStatus
			ERROR_DETECTED=true
		elif (grep 'wall clock time exceeded' "$WATCHFILE" ) || [ "$JOB_PAIR_DEADLOCKED" = true ]; then
			sendWallclockExceededStatus
			ERROR_DETECTED=true
		elif (grep 'VSize exceeded' "$WATCHFILE" ) then
			sendExceedMemStatus
			ERROR_DETECTED=true
		fi
	fi

	if [ "$ERROR_DETECTED" = false ] && ((DISK_QUOTA_EXCEEDED == 1)); then
		log "Error: disk quota exceeded"
		sendStageFailure "$ERROR_DISK_QUOTA_EXCEEDED" "${STAGE_NUMBERS[STAGE_INDEX]}"
		ERROR_DETECTED=true
	fi

	# This appears to be the idiomatic Bash way to test if a value is false.
	if [ "$ERROR_DETECTED" = false ]; then
		log "execution on $HOSTNAME complete"
		sendStageStatus "$STATUS_COMPLETE" "${STAGE_NUMBERS[STAGE_INDEX]}"

		if ((STAGE_INDEX == NUM_STAGES - 1)); then
			log "job finished successfully"
			sendStatus "$STATUS_COMPLETE" "${STAGE_NUMBERS[STAGE_INDEX]}"
		fi
		log "STAREXEC job $PAIR_ID completed successfully"
	else
		log "STAREXEC job $PAIR_ID exited with errors"
		sendStatusToLaterStages "$STATUS_NOT_REACHED" "${STAGE_NUMBERS[STAGE_INDEX]}"
		setRunStatsToZeroForLaterStages "${STAGE_NUMBERS[STAGE_INDEX]}"
		cleanUpAfterKilledBuildJob
		# Clean up working directory before exiting — same work as the normal
		# post-stage cleanup, but we must do it here because the break below
		# skips the universal cleanForNextStage call that follows this block.
		cleanForNextStage
		# A terminal error in any stage means later stages have no valid input;
		# executing them wastes compute and produces uninterpretable results.
		# LocalJobMonitor will mark unseen stages as STATUS_NOT_REACHED.
		break
	fi

	if [ $BUILD_JOB == "true" ]; then
		copySolverBack
	fi

	cleanForNextStage

	# update the path to the input to the output of the last stage
	BENCH_PATH="$SAVED_OUTPUT_DIR/$CURRENT_STAGE_NUMBER"
	OTHER_INPUT_PATH=$SAVED_OUTPUT_DIR"/"$CURRENT_STAGE_NUMBER"_output"

	# This stage is over and the next has not begun. A failure in between belongs to the pair,
	# not to the stage that just finished, so nothing may keep naming it (#145).
	#
	# This must stay BELOW the two assignments above: they read CURRENT_STAGE_NUMBER to point
	# the next stage at this stage's output. Moving it up sends the next stage to
	# $SAVED_OUTPUT_DIR/ instead.
	CURRENT_STAGE_NUMBER=
done

setEndTime

cleanWorkspace 0 $SANDBOX_PARAM
